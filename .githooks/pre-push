#!/bin/sh
# Pre-push gate for the fork's identity. Enabled via:
#   git config core.hooksPath .githooks
#
# 1. Never push to anything but the fork: a push whose remote URL names upstream
#    (incoai/splash) is refused for every ref.
# 2. Every upstream-merge commit in the pushed range must pass
#    dev/tools/verify_upstream_merge.sh. A merge counts as an upstream merge when
#    its second parent is in upstream/main; clones without an `upstream` remote
#    skip this part.
# 3. The pushed tip must carry no upstream release repo, tap or install command
#    (dev/tools/check_fork_identity.sh).

REMOTE_NAME="$1"
REMOTE_URL="$2"
ZERO=0000000000000000000000000000000000000000

case "$REMOTE_URL" in
    *incoai/splash*|*incoai/homebrew-tap*)
        echo "[pre-push] BLOCKED: $REMOTE_NAME ($REMOTE_URL) is upstream. This fork never pushes there." >&2
        exit 1 ;;
esac

STATUS=0
while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
    [ "$LOCAL_OID" = "$ZERO" ] && continue

    if git rev-parse -q --verify upstream/main >/dev/null 2>&1; then
        if [ "$REMOTE_OID" = "$ZERO" ]; then
            MERGES=$(git rev-list --merges "$LOCAL_OID" --not --remotes=origin 2>/dev/null)
        else
            MERGES=$(git rev-list --merges "$REMOTE_OID..$LOCAL_OID" 2>/dev/null)
        fi
        for MERGE in $MERGES; do
            SECOND=$(git rev-parse -q --verify "$MERGE^2") || continue
            git merge-base --is-ancestor "$SECOND" upstream/main || continue
            echo "[pre-push] upstream merge $(git log -1 --format='%h %s' "$MERGE") - running verify_upstream_merge.sh"
            if ! bash dev/tools/verify_upstream_merge.sh "$MERGE"; then
                echo "[pre-push] BLOCKED: $MERGE fails the upstream-merge gate. Fix, amend the merge commit, push again." >&2
                STATUS=1
            fi
        done
    fi

    if ! bash dev/tools/check_fork_identity.sh "$LOCAL_OID"; then
        echo "[pre-push] BLOCKED: $LOCAL_REF carries upstream identity (see above)." >&2
        STATUS=1
    fi
done

exit "$STATUS"
